{
  "inputs": [
    {
      "type": "promptString",
      "id": "azure-devops-org-url",
      "description": "Azure Devops Organisation URL. Eg. https://dev.azure.com/your-org-name",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azure-devops-project-name",
      "description": "Azure Devops Project Name",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azure-devops-pat",
      "description": "Azure Devops Personal Access Token",
      "password": true
    }
  ],
  "servers": {
    "azure-devops": {
      "type": "stdio",
      "command": "./bin/index.js",
      "env": {
        "AZURE_DEVOPS_ORG_URL": "${input:azure-devops-org-url}",
        "AZURE_DEVOPS_PROJECT_NAME": "${input:azure-devops-project-name}",
        "AZURE_DEVOPS_PERSONAL_ACCESS_TOKEN": "${input:azure-devops-pat}"
      }
    }
  }
}
